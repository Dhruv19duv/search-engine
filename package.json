{
  "name": "search-engine",
  "version": "1.0.0",
  "description": "Full-scale search engine with crawler, indexer, ranker, semantic drift detection, and ML-powered ranking",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest --config jest.config.js",
    "test:unit": "jest --testPathPattern='src/.*\\.test\\.ts$' --config jest.config.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "seed": "ts-node src/seed-data.ts",
    "benchmark": "ts-node src/benchmark.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "node-fetch": "^2.7.0",
    "cheerio": "^1.0.0-rc.12",
    "robots-parser": "^3.0.1",
    "natural": "^6.10.4",
    "stemmer": "^2.0.1",
    "heap-js": "^2.3.0",
    "xxhashjs": "^0.2.2",
    "mnemonist": "^0.39.5",
    "cluster": "^0.7.7",
    "winston": "^3.11.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/compression": "^1.7.5",
    "@types/node-fetch": "^2.6.9",
    "@types/cheerio": "^0.22.35",
    "@types/uuid": "^9.0.7",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2",
    "ts-node": "^10.9.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@types/jest": "^29.5.11",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0"
  }
}
